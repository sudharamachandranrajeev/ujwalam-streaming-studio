// SPDX-License-Identifier: GPL-3.0-or-later
// ujwalam-host: scene transition glitch (src/shader_transition.cpp, ujw_shader_transition). Embedded at build time.
// A digital glitch: red and blue split sideways and thin horizontal slices jump left or right, strongest at the switch
// (45 % to 55 %). The slices move to new places only 4 times per transition and only displace the picture (no brightness
// of their own); the split keeps the average brightness. So the frame's brightness changes once per switch: no strobe.

uniform float4x4 ViewProj;
uniform texture2d tex_a;
uniform texture2d tex_b;
uniform float t;
uniform float2 size;
uniform float2 dir;

sampler_state linearClamp {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float bump(float x) { return sin(3.14159265 * saturate(x)); }

float hash(float2 p) { return frac(sin(dot(p, float2(12.9898, 78.233))) * 43758.5453); }

float4 mixAt(float2 uv, float m)
{
	return lerp(tex_a.Sample(linearClamp, uv), tex_b.Sample(linearClamp, uv), m);
}

float4 PSGlitch(VertData v_in) : TARGET
{
	float s = bump(t);
	float m = smoothstep(0.45, 0.55, t);
	float slice = floor(v_in.uv.y * 24.0);
	float phase = floor(saturate(t) * 3.999);
	float h = hash(float2(slice, phase));
	float shift = (h > 0.7 ? (h - 0.85) * 0.25 : 0.0) * s * s;
	float2 uv = v_in.uv + float2(shift, 0.0);
	float split = 0.012 * s;
	float4 c = mixAt(uv, m);
	c.r = mixAt(uv - float2(split, 0.0), m).r;
	c.b = mixAt(uv + float2(split, 0.0), m).b;
	return c;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSGlitch(v_in);
	}
}
