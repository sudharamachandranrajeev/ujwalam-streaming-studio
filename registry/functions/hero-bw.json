        "nameY": { "type": "number", "minimum": 0.6, "maximum": 0.9 },
        "inMs": { "type": "integer", "minimum": 100, "maximum": 550 },
        "outMs": { "type": "integer", "minimum": 100, "maximum": 350 }
      }
    },
    "defaults": { "push": 1.08, "nameSizeOfHeight": 0.08, "nameY": 0.8, "inMs": 500, "outMs": 300 },
    "safeRanges": { "push": [1.0, 1.15], "nameSizeOfHeight": [0.04, 0.14], "nameY": [0.6, 0.9], "inMs": [100, 550], "outMs": [100, 350] }
