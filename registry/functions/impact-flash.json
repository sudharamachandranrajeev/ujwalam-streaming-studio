{
  "id": "impact-flash",
  "version": "1.0.0",
  "category": "ai-clipping",
  "family": "clipping",
  "name": "Impact flash (BD4)",
  "description": "A short white (or tinted) flash over the whole frame on an impact (the first drop, kills on beats): `frames` frames at `alpha`. Flash safety: re-spaced on the final beat-synced timeline (at least minGapSec apart and at most maxPerSec in any second, never above 3); a flash that does not fit becomes a colour pulse (pulseColour at pulseAlpha for pulseMs, under the flash threshold). Rendered flash rate measured from frame luminance (tests/py/test_beatdrop.py, the fx test analyser). BeatDrop montages (D415), flag beatdrop; tunable per preset. Real footage UNVERIFIED.",
  "params": {
    "schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "alpha": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 0.7
        },
        "colour": {
          "type": "string",
          "pattern": "^(white|0x[0-9A-Fa-f]{6})$"
        },
        "pulseColour": {
          "type": "string",
          "pattern": "^0x[0-9A-Fa-f]{6}$"
        },
        "pulseAlpha": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 0.2
        },
        "pulseMs": {
          "type": "integer",
          "minimum": 80,
          "maximum": 350
        },
        "minGapSec": {
          "type": "number",
          "minimum": 0.34,
          "maximum": 1.0
        },
        "maxPerSec": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      }
    },
    "defaults": {
      "frames": 2,
      "alpha": 0.5,
      "colour": "white",
      "pulseColour": "0xFF2E63",
      "pulseAlpha": 0.12,
      "pulseMs": 200,
      "minGapSec": 0.34,
      "maxPerSec": 3
    },
    "safeRanges": {
      "frames": [
        1,
        3
      ],
      "alpha": [
        0.2,
        0.7
      ],
      "pulseAlpha": [
        0.05,
        0.2
      ],
      "pulseMs": [
        80,
        350
      ],
      "minGapSec": [
        0.34,
        1.0
      ],
      "maxPerSec": [
        1,
        3
      ]
    }
  },
  "canvases": [
    "V",
    "H"
  ],
  "themeTokens": [],
  "durationMs": 350,
  "maxConcurrent": 1,
  "flashesPerSec": 3,
  "budgetCost": 0,
  "status": "in-progress",
  "format": "post-render",
  "planSection": "BD4"
}
